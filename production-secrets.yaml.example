# Production Secrets Template
# 
# ⚠️ NEVER commit this file with real passwords to Git!
# 
# Instructions:
# 1. Copy this file: cp production-secrets.yaml.example production-secrets.yaml
# 2. Generate secure passwords:
#    MYSQL_ROOT_PASSWORD=$(openssl rand -base64 32)
#    MYSQL_PASSWORD=$(openssl rand -base64 32)
# 3. Replace the values below
# 4. Keep production-secrets.yaml in .gitignore

mysql:
  auth:
    # Generate with: openssl rand -base64 32
    rootPassword: "REPLACE_WITH_SECURE_PASSWORD"
    
    # Generate with: openssl rand -base64 32
    password: "REPLACE_WITH_SECURE_PASSWORD"
    
    # These can remain as-is or be changed
    database: "targets"
    username: "targets"

# Optional: Add TLS certificate paths if using custom certs
# ingress:
#   tls:
#     - secretName: target-app-tls-custom
#       certificate: /path/to/cert.pem
#       key: /path/to/key.pem
